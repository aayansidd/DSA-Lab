#include <iostream>
using namespace std;

void revarr(int arr[],int left, int right) {
    int temp;

    if (left >= right) {
        return; 
    } else{
        temp = arr[left];
        arr[left] = arr[right];
        arr[right] = temp;
        revarr(arr, left + 1, right - 1);
    }

    
    
}

int main() {
  int numbers [6];

  cout << "Enter 6 numbers into the array";
  for (int x = 0; x < 6; x++){
     cin >> numbers[x]; 
  }
  revarr(numbers, 0, 5);
  
  for (int x = 0; x < 6; x++){
     cout << numbers[x]; 
  }
}
