#include <iostream>
using namespace std;
class Student{


    public:
            //public attributes declared here
            int rollNumber; 
            int marks;
    
        Student(int r, int m) : rollNumber(r), marks(m) {}

        void display(){
            cout << rollNumber << endl;
            cout << marks << endl;
        }

};

int main() {
    Student s1(1,75);
    Student s2(2,90);
    s1.display();
    s2.display(); 
}
